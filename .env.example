# Copia este archivo a .env (nunca lo subas a git).

# --- LLM (API de Meta, compatible con el SDK de OpenAI) ---
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
# IDs verificados con GET /v1/models: muse-spark-1.3, muse-spark-1.2, muse-spark-1.1, ...
MUSE_MODEL=muse-spark-1.3
LLM_TIMEOUT_S=120
LLM_MAX_ATTEMPTS=4

# --- Ingesta ---
# Directorio de trabajo para workspaces temporales (por defecto ./.data)
# WORK_DIR=
ZIP_MAX_UPLOAD_BYTES=52428800
ZIP_MAX_UNCOMPRESSED_BYTES=209715200
ZIP_MAX_FILES=10000
WORKSPACE_MAX_BYTES=524288000
GIT_TIMEOUT_S=120

# --- Sandbox (Docker) ---
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_CPUS=1
SANDBOX_MEMORY=512m
SANDBOX_PIDS=256
SANDBOX_TIMEOUT_S=60
SANDBOX_OUTPUT_LIMIT=65536
# Tamaño del tmpfs /out de cada ejecución
SANDBOX_OUT_BYTES=16777216

# --- Fase 2: build con red / test sin red ---
BUILD_TIMEOUT_S=180
BUILD_MEMORY=1g
# Imagen de tests ocultos; vacío = se construye desde backend/sandbox/runner_image
# RUNNER_IMAGE=

# --- Fase 2: tareas y suite oculta ---
# Por defecto <WORK_DIR>/tasks (fuera de cualquier workspace de entrega)
# TASK_STORE_DIR=
SUITE_MAX_REGENERATIONS=2
HIDDEN_TEST_TIMEOUT_S=30

# --- Fase 3: caja negra ---
# Timeout de cada llamada a la entrega por el canal (perfil script)
CALL_TIMEOUT_S=5
# Tiempo máximo del contenedor confiable que corre la suite
BLACKBOX_SUITE_TIMEOUT_S=300

# --- Fase 4 ---
# npm ci de proyectos reales (Vite, binarios nativos) tarda minutos
NPM_INSTALL_TIMEOUT_S=600

# --- Fase 4: roles y escrow en Stellar testnet ---
# Token del árbitro (backend); genera uno aleatorio largo.
ARBITER_TOKEN=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ESCROW_CONTRACT_ID=CBOQPA5WO7TSQ7WQLCRRIEYCXPIPZZQERNI5GNL7NHXPKQLB3VAOCHLW
USDC_CONTRACT_ID=CAZBUP6Z4A33I7HA57QN5EYNPLT5JISFJUELWHMAUI5GASI54TVGX3IR
USDC_ASSET=USDC:GDJBRQ7SGVQTPJ3OOUNPYGGYN6OU5PJSY5FGCQGMQ7EK56E72LMV56I6
# Secretos de cuentas de TESTNET (stellar keys generate ... --fund). Nunca de mainnet.
ARBITER_SECRET=
DEMO_CLIENT_SECRET=
DEMO_FREELANCER_SECRET=
# Repos privados vía GitHub App (permiso Contents: read-only)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
